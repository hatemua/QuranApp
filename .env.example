# MongoDB connection string (used by API + seed import)
MONGODB_URI=mongodb://localhost:27017/quranic_immersion

# JWT signing secret for the API (32+ random bytes in production)
JWT_SECRET=change-me-to-a-long-random-secret-string-of-at-least-32-bytes

# API server port
API_PORT=3000

# Android app reads this at build time via local.properties → BuildConfig.API_BASE_URL
# 10.0.2.2 is the loopback address of the host machine from an Android emulator
API_BASE_URL=http://10.0.2.2:3000
