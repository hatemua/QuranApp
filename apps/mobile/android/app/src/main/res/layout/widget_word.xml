<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#78716C"
        android:fontFamily="sans-serif"
        tools:text="1:1"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textColor="#1C1917"
        android:gravity="center"
        android:textDirection="rtl"
        android:fontFamily="@font/amiri_bold"
        android:layout_marginTop="6dp"
        tools:text="بِسْمِ"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_translit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#78716C"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        tools:text="bismi"
        xmlns:tools="http://schemas.android.com/tools" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">
        <TextView
            android:id="@+id/widget_option_a"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:padding="6dp"
            android:textSize="13sp"
            android:textColor="#1C1917"
            android:background="@drawable/widget_button_outline"
            tools:text="In (the) name"
            xmlns:tools="http://schemas.android.com/tools" />
        <TextView
            android:id="@+id/widget_option_b"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:textSize="13sp"
            android:textColor="#1C1917"
            android:background="@drawable/widget_button_outline"
            tools:text="The path"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:weightSum="2">
        <TextView
            android:id="@+id/widget_option_c"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:padding="6dp"
            android:textSize="13sp"
            android:textColor="#1C1917"
            android:background="@drawable/widget_button_outline"
            tools:text="The mercy"
            xmlns:tools="http://schemas.android.com/tools" />
        <TextView
            android:id="@+id/widget_option_d"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:textSize="13sp"
            android:textColor="#1C1917"
            android:background="@drawable/widget_button_outline"
            tools:text="The judgment"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/widget_action_audio"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_play"
            android:padding="6dp"
            android:contentDescription="Play audio" />
        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />
        <ImageView
            android:id="@+id/widget_action_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_next"
            android:padding="6dp"
            android:contentDescription="Next word" />
        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />
        <ImageView
            android:id="@+id/widget_action_open"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_open"
            android:padding="6dp"
            android:contentDescription="Open app" />
    </LinearLayout>

</LinearLayout>
